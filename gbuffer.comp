#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

// Pass 0: primary visibility by ray tracing (no rasteriser anywhere).
void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(px, U.misc0.xy))) return;
    ivec2 ip = ivec2(px);

    vec3 d = primaryDir(px);
    Hit h;
    if (!traceClosest(U.camPos.xyz, d, 1e4, h)) {
        imageStore(gND,     ip, vec4(0.0, 0.0, 0.0, -1.0));
        imageStore(gAlbedo, ip, vec4(0.0));
        return;
    }
    Tri  t  = tris[h.prim];
    vec3 ng = triNormal(t);
    bool emissive = max(t.emission.r, max(t.emission.g, t.emission.b)) > 0.0 && dot(ng, -d) > 0.0;
    vec3 n = dot(ng, d) > 0.0 ? -ng : ng;

    imageStore(gND,     ip, vec4(n, h.t));
    imageStore(gAlbedo, ip, emissive ? vec4(t.emission.rgb, 1.0) : vec4(triAlbedo(t, h.bary, texLod(t, h.t)), 0.0));
}
