#main scene thing

# material <id> [color r g b] [texture id] [normal id] [smoothness 0..1] [metallic 0..1] [reflectivity 0..1] [ssr on|off]
# Declare normal maps with "texture <id> <file>" and reference them with "normal <id>".
# Assign a material to an object with "spawn ... material <id>" or "set <object> material <id>".

builtin pointlights 0

gi screen
gi offscreen 4
area on

denoise 1

dlss perfomance

# Auto-generated by SCR Editor
# Edit below and press Apply, or use the viewport tools.

texture monkey1_mat_albedo E:\cppprojects\rtengine\projects\builtinproject\checker.png
texture cube1_mat_albedo E:\cppprojects\rtengine\assets\builtin\grid.png
texture cube1_mat_normal E:\cppprojects\rtengine\assets\builtin\gridnm.png
texture cube3_mat_albedo E:\cppprojects\rtengine\assets\builtin\goofysmile.png

model monkey E:\cppprojects\rtengine\projects\builtinproject\monkey.obj

material cube1_mat color 1.000 1.000 1.000 texture cube1_mat_albedo normal cube1_mat_normal metallic 0.062 smoothness 0.203
material cube3_mat color 1.000 1.000 1.000 texture monkey1_mat_albedo smoothness 0.000
material monkey1_mat color 1.000 1.000 1.000 texture monkey1_mat_albedo smoothness 0.107
material sphere1_mat color 1.000 1.000 1.000

spawn cube1 cube pos 0.522 0.500 0.000 size 10.869 0.100 9.500 color 1.000 1.000 1.000 material cube1_mat body static
spawn sphere1 sphere pos 0.493 1.330 0.608 size 1.000 1.000 1.000 color 0.400 0.650 0.900 material sphere1_mat
spawn cube2 cube pos 0.414 1.900 -2.452 size 1.000 1.000 1.000 color 1.000 0.510 0.409 body dynamic mass 1.000
spawn cube3 cube pos -2.468 1.750 3.474 size 1.000 1.000 1.000 rot 180.000 0.000 0.000 color 0.800 0.600 0.400 material cube3_mat
spawn monkey1 monkey pos 3.658 1.841 1.317 size 2.248 2.248 2.248 rot -17.500 -25.000 0.000 color 0.800 0.800 0.800 material monkey1_mat

light point lamp1 -2.081 3.000 2.000 1.000 0.000 0.000 7.800 intensity 20.320
light point lamp2 2.884 2.900 -1.772 0.000 1.000 0.065 7.100 intensity 15.700
light point lamp3 -1.766 2.500 -1.685 0.223 0.254 1.000 8.000 intensity 20.010
light point lamp4 4.661 2.460 3.081 1.000 0.667 0.000 8.100 intensity 15.360
light point lamp5 -1.903 5.161 -0.546 0.591 1.000 0.000 8.300 intensity 20.250
# light spot test1 0 4 0  0 -1 0  1 0.2 0.2  10 40 25 intensity 50
var $lampX -2.0
var $lampDirection 1
var $lampX -2.0
var $lampDirection 1


on key V
  rand $x -2 2
  rand $y 0.5 4.5
  rand $z -2 2
  rand $r 0.2 1
  rand $g 0.2 1
  rand $b 0.2 1
  light point lamp# $x $y $z $r $g $b 0.1 6 0.05
end

on key J
  calc $lampX $lampX + 2
end

on frame
  calc $lampStep $dt * 0.6
  calc $lampStep $lampStep * $lampDirection
  calc $lampX $lampX + $lampStep
  if $lampX >= -1.5
  var $lampDirection -1
  endif
  if $lampX <= -2.5
  var $lampDirection 1
  endif
  set lamp1 pos $lampX 3 2
end

on key V
  rand $x -2 2
  rand $y 0.5 4.5
  rand $z -2 2
  rand $r 0.2 1
  rand $g 0.2 1
  rand $b 0.2 1
  light point lamp# $x $y $z $r $g $b 0.1 6 0.05
end

on key J
  calc $lampX $lampX + 2
end

on frame
  calc $lampStep $dt * 0.6
  calc $lampStep $lampStep * $lampDirection
  calc $lampX $lampX + $lampStep
  if $lampX >= -1.5
  var $lampDirection -1
  endif
  if $lampX <= -2.5
  var $lampDirection 1
  endif
  set lamp1 pos $lampX 3 2
end

builtin sun

