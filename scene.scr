# Auto-generated by SCR Editor
# Edit below and press Apply, or use the viewport tools.

builtin pointlights 1
builtin spots

# ---- global illumination + light options
gi cache          # path | cache | screen   (N cycles modes while running, H = GI rate, L = area lights)
area on           # off: emissive panels stop emitting, only point / spot / sun lights remain

# ---- denoising + collisions
denoise 4         # 0 = off, 1 = default, up to 4 = very soft (B toggles it while running)

texture room2 assets/wall.png

model room assets/untitled.obj

spawn cube1 room pos 0.529 1.660 0.888 size 6.000 6.000 6.000 color 0.850 0.550 0.350 tex room2
spawn sphere1 sphere pos 0.700 0.960 0.000 size 1.000 1.000 1.000 color 0.400 0.650 0.900

light point lamp1 -0.100 12.150 0.400 1.000 1.000 1.000 17.600

on key V
  rand $x -2 2
  rand $y 0.5 4.5
  rand $z -2 2
  rand $r 0.2 1
  rand $g 0.2 1
  rand $b 0.2 1
  light point lamp# $x $y $z $r $g $b 0.1 6 0.05
end

builtin sun