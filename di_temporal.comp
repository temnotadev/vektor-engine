#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;


void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(px, U.misc0.xy))) return;
    ivec2 ip = ivec2(px);

    vec4 nd  = imageLoad(gND, ip);
    Res  cur = unpackRes(imageLoad(resInit, ip));
    if (nd.w <= 0.0) { imageStore(resTCur, ip, packRes(cur)); return; }

    vec3 n = nd.xyz;
    vec3 p = worldPos(px, nd.w);
    uint s = seedFor(px, U.misc0.z, 3u);

    if (U.misc2.w != 0u) {
        float wsumSolar = 0.0, selectedTargetSolar = 0.0, confidenceSolar = 0.0;
        uint selectedLightSolar = NO_LIGHT;
        vec2 selectedUSolar = vec2(0.0);

        ivec2 previousPixel;
        Res previousReservoir = emptyRes();
        vec3 previousPosition = vec3(0.0), previousNormal = vec3(0.0);
        bool havePrevious = (U.misc0.w & 1u) != 0u && U.misc0.z > 0u &&
                            reproject(p, previousPixel) && historyValid(previousPixel, p, n);
        if (havePrevious) {
            vec4 previousSurface = imageLoad(gNDPrev, previousPixel);
            previousPosition = previousWorldPos(previousPixel, previousSurface.w);
            previousNormal = previousSurface.xyz;
            previousReservoir = unpackRes(imageLoad(resTPrev, previousPixel));
            if (badf(previousReservoir.W) || badf(previousReservoir.M)) {
                previousReservoir = emptyRes();
            }
            previousReservoir.M = min(previousReservoir.M, 20.0);
            havePrevious = previousReservoir.light != NO_LIGHT &&
                           previousReservoir.W > 0.0 && previousReservoir.M > 0.0;
        }

        bool haveCurrent = cur.light != NO_LIGHT && cur.W > 0.0 && cur.M > 0.0;
        float currentTarget = haveCurrent ? targetPdf(p, n, cur.light, cur.u) : 0.0;
        float previousTargetCurrent = havePrevious
            ? targetPdf(p, n, previousReservoir.light, previousReservoir.u) : 0.0;

        float currentWeight = currentTarget * cur.W;
        float previousWeight = previousTargetCurrent * previousReservoir.W;
        if (havePrevious && haveCurrent) {
            float currentTargetPrevious = targetPdf(previousPosition, previousNormal, cur.light, cur.u);
            float previousTargetPrevious = targetPdf(previousPosition, previousNormal,
                                                      previousReservoir.light, previousReservoir.u);
            currentWeight *= balanceHeuristic(cur.M * currentTarget,
                                              previousReservoir.M * currentTargetPrevious);
            previousWeight *= balanceHeuristic(previousReservoir.M * previousTargetPrevious,
                                               cur.M * previousTargetCurrent);
        }

        if (haveCurrent) {
            resUpdate(wsumSolar, selectedLightSolar, selectedUSolar, selectedTargetSolar,
                      cur.light, cur.u, currentTarget, currentWeight, s);
            confidenceSolar += cur.M;
        }
        if (havePrevious) {
            resUpdate(wsumSolar, selectedLightSolar, selectedUSolar, selectedTargetSolar,
                      previousReservoir.light, previousReservoir.u, previousTargetCurrent,
                      previousWeight, s);
            confidenceSolar += previousReservoir.M;
        }

        Res solarReservoir;
        solarReservoir.light = selectedLightSolar;
        solarReservoir.u = selectedUSolar;
        solarReservoir.M = confidenceSolar;
        solarReservoir.W = selectedTargetSolar > 0.0 ? wsumSolar / selectedTargetSolar : 0.0;
        if (badf(solarReservoir.W) || badf(solarReservoir.M) || badf(wsumSolar)) {
            solarReservoir = emptyRes();
        }
        imageStore(resTCur, ip, packRes(solarReservoir));
        return;
    }

    float wsum = 0.0, selP = 0.0, M = 0.0;
    uint  selTri = NO_LIGHT;
    vec2  selB = vec2(0.0);

    if (cur.light != NO_LIGHT) {
        float ph = targetPdf(p, n, cur.light, cur.u);
        resUpdate(wsum, selTri, selB, selP, cur.light, cur.u, ph, ph * cur.W * cur.M, s);
        M += cur.M;
    }

    if ((U.misc0.w & 5u) == 1u && U.misc0.z > 0u) {
        ivec2 pp;
        if (reproject(p, pp) && historyValid(pp, p, n)) {
            Res prev = unpackRes(imageLoad(resTPrev, pp));
            if (badf(prev.W) || badf(prev.M)) prev = emptyRes();
            
            
            prev.M = min(prev.M, U.params2.z); 
            
            if (prev.light != NO_LIGHT && prev.M > 0.0) {
                float ph = targetPdf(p, n, prev.light, prev.u);
                resUpdate(wsum, selTri, selB, selP, prev.light, prev.u, ph, ph * prev.W * prev.M, s);
                M += prev.M;
            }
        }
    }

    Res r;
    r.light = selTri; r.u = selB; r.M = M;
    r.W = (selP > 0.0 && M > 0.0) ? wsum / (M * selP) : 0.0;

    if (r.light != NO_LIGHT && r.W > 0.0) {
        LightEval e = evalLight(r.light, r.u, p, n);
        if (occluded(p + n * RAY_EPS, e.wi, e.dist - 2.0 * RAY_EPS)) r.W = 0.0;
    }
    
    if (badf(r.W) || badf(r.M) || badf(wsum)) r = emptyRes();
    imageStore(resTCur, ip, packRes(r));
}