#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;



void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(px, U.misc0.xy))) return;
    ivec2 ip = ivec2(px);

    vec4 nd = imageLoad(gND, ip);
    Res  c  = unpackRes(imageLoad(resTCur, ip));
    if (nd.w <= 0.0) {
        imageStore(resSpatial, ip, packRes(emptyRes()));
        if (U.misc2.w != 0u) imageStore(resInit, ip, packRes(emptyRes()));
        return;
    }

    vec3 n = nd.xyz;
    vec3 p = worldPos(px, nd.w);
    uint s = seedFor(px, U.misc0.z, 4u);

    if (U.misc2.w != 0u) {
        Res solarReservoir = c;
        if ((U.misc0.w & 2u) != 0u) {
            for (int i = 0; i < 5; ++i) {
                float angle = 6.28318530718 * rnd(s);
                float distance = 30.0 * sqrt(rnd(s));
                ivec2 q = ip + ivec2(round(vec2(cos(angle), sin(angle)) * distance));
                if (q == ip || any(lessThan(q, ivec2(0))) ||
                    any(greaterThanEqual(q, ivec2(U.misc0.xy)))) continue;

                vec4 neighborSurface = imageLoad(gND, q);
                if (neighborSurface.w <= 0.0 || dot(neighborSurface.xyz, n) < 0.95) continue;

                vec3 neighborPosition = worldPos(uvec2(q), neighborSurface.w);
                float depthTolerance = max(4.0 * RAY_EPS,
                    max(length(p - U.camPos.xyz), length(neighborPosition - U.camPos.xyz)) * U.params2.w);
                if (abs(dot(neighborPosition - p, n)) > depthTolerance ||
                    abs(dot(neighborPosition - p, neighborSurface.xyz)) > depthTolerance) continue;

                Res neighborReservoir = unpackRes(imageLoad(resTCur, q));
                if (neighborReservoir.light == NO_LIGHT || neighborReservoir.W <= 0.0 ||
                    neighborReservoir.M <= 0.0) continue;

                float neighborTargetCurrent = targetPdf(p, n, neighborReservoir.light,
                                                        neighborReservoir.u);
                bool haveCurrent = solarReservoir.light != NO_LIGHT &&
                                   solarReservoir.W > 0.0 && solarReservoir.M > 0.0;
                float currentTarget = haveCurrent
                    ? targetPdf(p, n, solarReservoir.light, solarReservoir.u) : 0.0;
                float neighborTargetNeighbor = targetPdf(neighborPosition, neighborSurface.xyz,
                                                         neighborReservoir.light, neighborReservoir.u);
                float currentTargetNeighbor = haveCurrent
                    ? targetPdf(neighborPosition, neighborSurface.xyz, solarReservoir.light,
                                solarReservoir.u) : 0.0;

                float currentWeight = haveCurrent ? currentTarget * solarReservoir.W : 0.0;
                float neighborWeight = neighborTargetCurrent * neighborReservoir.W;
                if (haveCurrent) {
                    currentWeight *= balanceHeuristic(solarReservoir.M * currentTarget,
                                                       neighborReservoir.M * currentTargetNeighbor);
                    neighborWeight *= balanceHeuristic(neighborReservoir.M * neighborTargetNeighbor,
                                                       solarReservoir.M * neighborTargetCurrent);
                }

                float weightSum = currentWeight + neighborWeight;
                if (weightSum <= 0.0) continue;
                if (rnd(s) * weightSum < neighborWeight) {
                    solarReservoir.light = neighborReservoir.light;
                    solarReservoir.u = neighborReservoir.u;
                    solarReservoir.W = weightSum / neighborTargetCurrent;
                } else {
                    solarReservoir.W = weightSum / currentTarget;
                }
                solarReservoir.M = (haveCurrent ? solarReservoir.M : 0.0) +
                                   neighborReservoir.M;
            }
        }

        Res historyReservoir = solarReservoir;
        if (solarReservoir.light != NO_LIGHT && solarReservoir.W > 0.0) {
            LightEval selectedLight = evalLight(solarReservoir.light, solarReservoir.u, p, n);
            if (occluded(p + n * RAY_EPS, selectedLight.wi, selectedLight.dist - 2.0 * RAY_EPS)) {
                solarReservoir.W = 0.0;
            }
        }
        imageStore(resInit, ip, packRes(historyReservoir));
        imageStore(resSpatial, ip, packRes(solarReservoir));
        return;
    }

    if ((U.misc0.w & 2u) == 0u) { imageStore(resSpatial, ip, packRes(c)); return; }

    float wsum = 0.0, selP = 0.0, M = 0.0;
    uint  selTri = NO_LIGHT;
    vec2  selB = vec2(0.0);

    if (c.light != NO_LIGHT) {
        float ph = targetPdf(p, n, c.light, c.u);
        resUpdate(wsum, selTri, selB, selP, c.light, c.u, ph, ph * c.W * c.M, s);
        M += c.M;
    }

    const int NEIGHBORS = 10;
    float radius = U.params.z;
    for (int i = 0; i < NEIGHBORS; ++i) {
        vec2  o = (vec2(rnd(s), rnd(s)) * 2.0 - 1.0) * radius;
        ivec2 q = ip + ivec2(round(o));
        if (q == ip || any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(U.misc0.xy)))) continue;

        vec4 nq = imageLoad(gND, q);
        if (nq.w <= 0.0 || dot(nq.xyz, n) < 0.95) continue;

        vec3 pq = worldPos(uvec2(q), nq.w);
        float depthTolerance = max(4.0 * RAY_EPS,
                                   max(length(p - U.camPos.xyz), length(pq - U.camPos.xyz)) * U.params2.w);
        if (abs(dot(pq - p, n)) > depthTolerance ||
            abs(dot(pq - p, nq.xyz)) > depthTolerance) continue;

        Res rq = unpackRes(imageLoad(resTCur, q));
        if (rq.light == NO_LIGHT || rq.M <= 0.0) continue;

        float ph = targetPdf(p, n, rq.light, rq.u);
        resUpdate(wsum, selTri, selB, selP, rq.light, rq.u, ph, ph * rq.W * rq.M, s);
        M += rq.M;
    }

    Res r;
    r.light = selTri; r.u = selB; r.M = M;
    r.W = (selP > 0.0 && M > 0.0) ? wsum / (M * selP) : 0.0;

    bool reusedNeighbor = c.W <= 0.0 || r.light != c.light || any(notEqual(r.u, c.u));
    if (reusedNeighbor && r.light != NO_LIGHT && r.W > 0.0) {
        LightEval e = evalLight(r.light, r.u, p, n);
        if (occluded(p + n * RAY_EPS, e.wi, e.dist - 2.0 * RAY_EPS)) {
            if (c.light != NO_LIGHT && c.W > 0.0) r = c;
            else r = emptyRes();
        }
    }

    imageStore(resSpatial, ip, packRes(r));
}
