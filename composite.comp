#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

vec3 aces(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// ---- SSR resolve ------------------------------------------------------------------------------
// Tunables for the reflection blend.
#define SSR_F0_DIELECTRIC     0.04   // F0 of a non-metal at reflectivity 0 (the material's `reflectivity` lerps it to 1)
#define SSR_ROUGH_FADE_START  0.45   // reflections start to fade out above this roughness ...
#define SSR_UPSAMPLE_FOOTPRINT_PX 3.0 // bilateral slack of the upsample (full-res px)

// Bilinear + bilateral upsample of the half-res SSR buffer (uSSRHistCur, premultiplied coverage).
// Each of the 4 surrounding half-res texels gets  bilinearWeight * depth/normal similarity  to THIS
// pixel's surface. (The previous version used depth weights only -> a plain box average of the 2x2
// block, which is what produced the visible 2x2 blocks.) Returns premultiplied (rgb, coverage).
vec4 ssrUpsample(ivec2 ip) {
    ivec2 halfSize = ssrHalfSize();
    // Texel h sits at full-res pixel 2h+1 (ssrRepPx), the pixel it was traced from.
    vec2  hf = (vec2(ip) - 1.0) * 0.5;
    ivec2 h0 = ivec2(floor(hf));
    vec2  f  = hf - vec2(h0);

    SsrSurf c = ssrSurfAt(ip);
    vec4  acc  = vec4(0.0);
    float wsum = 0.0;
    for (int y = 0; y <= 1; ++y) {
        for (int x = 0; x <= 1; ++x) {
            ivec2 h  = clamp(h0 + ivec2(x, y), ivec2(0), halfSize - 1);
            float bw = (x == 1 ? f.x : 1.0 - f.x) * (y == 1 ? f.y : 1.0 - f.y);
            SsrSurf s = ssrSurfAt(ssrRepPx(h));
            // 1e-3 floor: if no tap matches (thin geometry) we still resolve to the best-fitting
            // neighbour mix instead of punching a hole.
            float w = bw * (ssrBilateralWeight(c, s, SSR_UPSAMPLE_FOOTPRINT_PX) + 1e-3);
            acc  += imageLoad(uSSRHistCur, h) * w;
            wsum += w;
        }
    }
    return acc / max(wsum, 1e-6);
}

// Schlick Fresnel with the roughness-aware grazing term (Lagarde): rough surfaces can't reach F = 1
// at grazing angles, which is what makes their reflections fade instead of turning into mirrors.
vec3 ssrFresnel(vec3 F0, float NdotV, float roughness) {
    float k = pow(1.0 - clamp(NdotV, 0.0, 1.0), 5.0);
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * k;
}

vec3 blurSpecular(ivec2 centerPx) {
    vec4 centerND = imageLoad(gND, centerPx);
    vec4 centerMaterial = imageLoad(gMaterial, centerPx);
    vec3 centerNormal = normalize(centerND.xyz);
    vec3 centerSpec = imageLoad(directSpec, centerPx).rgb;
    vec3 filtered = centerSpec * 2.0;
    float totalWeight = 2.0;
    float depthSigma = max(centerND.w * 0.03, 0.015);
    const ivec2 offsets[4] = ivec2[4](
        ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));

    for (int i = 0; i < 4; ++i) {
        ivec2 samplePx = centerPx + offsets[i];
        if (any(lessThan(samplePx, ivec2(0))) ||
            any(greaterThanEqual(samplePx, ivec2(U.misc0.xy)))) continue;

        vec4 sampleND = imageLoad(gND, samplePx);
        if (sampleND.w <= 0.0) continue;

        vec4 sampleMaterial = imageLoad(gMaterial, samplePx);
        float normalWeight = pow(max(dot(centerNormal, normalize(sampleND.xyz)), 0.0), 8.0);
        float depthWeight = exp(-abs(centerND.w - sampleND.w) / depthSigma);
        float materialDelta = abs(centerMaterial.x - sampleMaterial.x) +
                              abs(centerMaterial.y - sampleMaterial.y);
        float materialWeight = exp(-8.0 * materialDelta);
        float weight = normalWeight * depthWeight * materialWeight;

        filtered += imageLoad(directSpec, samplePx).rgb * weight;
        totalWeight += weight;
    }

    return filtered / totalWeight;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(px, U.misc0.xy))) return;
    ivec2 ip = ivec2(px);

    vec4 nd  = imageLoad(gND, ip);
    vec4 alb = imageLoad(gAlbedo, ip);
    vec4 mat = imageLoad(gMaterial, ip);
    vec3 color = vec3(0.0), lit = vec3(0.0);

    if (nd.w > 0.0 && alb.a > 0.5) {
        color = alb.rgb;                                       
    } else if (nd.w > 0.0) {
        float metallic = clamp(mat.x, 0.0, 1.0);
        vec3 direct = alb.rgb * imageLoad(dirCur, ip).rgb * (1.0 - metallic) +
                      blurSpecular(ip);
        vec3 gi = imageLoad(giCur, ip).rgb;
        lit = direct + alb.rgb * gi * (1.0 - metallic);
        uint mode = U.misc1.y;                                 
        if (mode != 2u) color += direct;
        if (mode != 1u) color += alb.rgb * gi * (1.0 - metallic);
        if (mat.w > 0.5 && mat.y > 0.0) {
            // Screen-space reflections: traced half-res by ssr_half.comp, filtered/accumulated by
            // ssr_blur.comp, stored premultiplied in uSSRHistCur (rgb = colour * coverage, a = coverage =
            // hit mask * screen-edge fade).
            vec4 ssr = ssrUpsample(ip);
            if (ssr.a > 1e-4) {
                vec3  ssrColor  = ssr.rgb / ssr.a;
                float roughness = 1.0 - clamp(mat.y, 0.0, 1.0);
                float NdotV     = clamp(dot(normalize(nd.xyz), -primaryDir(px)), 0.0, 1.0);

                // F0: dielectric base lerped towards 1 by the material's `reflectivity`, towards the
                // albedo by `metallic`.
                vec3 F0 = mix(vec3(mix(SSR_F0_DIELECTRIC, 1.0, clamp(mat.z, 0.0, 1.0))), alb.rgb, metallic);
                vec3 F  = ssrFresnel(F0, NdotV, roughness);

                // finalReflectionAlpha = ssrHitMask * fresnel * edgeFade * ssrOpacity
                //   ssr.a = hitMask * edgeFade; fresnel = luminance of the roughness-aware Schlick term;
                //   roughAtten additionally fades very rough surfaces out.
                float fresnel    = luminance(F);
                float roughAtten = 1.0 - smoothstep(SSR_ROUGH_FADE_START, 1.0, roughness);
                float alpha = clamp(ssr.a * fresnel * roughAtten * clamp(U.ssrParams.x, 0.0, 1.0), 0.0, 1.0);

                // Coloured Fresnel (metals) is kept as a hue tint on the reflection so the blend itself
                // stays the plain scalar lerp: base -> reflection.
                vec3 tint = F / max(fresnel, 1e-4);
                color = mix(color, ssrColor * tint, alpha);
            }
        }
    } else {
        color = skyRadiance(primaryDir(px));
    }
    imageStore(litCur, ip, vec4(lit, 1.0));                    

    color = aces(color * U.params.x);
    color = pow(color, vec3(1.0 / 2.2));
    imageStore(finalImg, ip, vec4(color, 1.0));
}
